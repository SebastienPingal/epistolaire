# Copier ce fichier en `.env` pour développer en local. Le fichier `.env` n'est jamais commité.

# Adresse de la base PostgreSQL locale (ou d'une branche Neon de test).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epistolaire

# L'adresse qui ouvre le compte du MJ.
MJ_EMAIL=mj@exemple.fr

# Sans SMTP_HOST, les e-mails ne partent pas : ils s'affichent dans la console du serveur.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Le secret que la planification joint à l'appel des tâches (/api/taches/...).
# Sur Vercel, une vraie valeur tirée au hasard ; en local, n'importe quoi.
CRON_SECRET=essai

# Les clés des notifications du navigateur. Celles-ci ne servent qu'aux essais locaux :
# le site en ligne a sa propre paire, posée dans les variables de Vercel.
VAPID_PUBLIC=BAzSFYuVev4XQKFcOSOpbLovtm-HD7z02MAw6gWxbYlZ7LQapIHJ3LgO2fVDKu5EnOGkpGCmVm6ebrn6M-RSK7c
VAPID_PRIVATE=oJzN6My2bXClGZWxUqpEpNkpbKU7A3bDPhvy43PCEbo
VAPID_SUJET=mailto:mj@exemple.fr
