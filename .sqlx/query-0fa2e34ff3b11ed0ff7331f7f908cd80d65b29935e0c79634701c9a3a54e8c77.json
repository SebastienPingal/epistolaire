{
  "db_name": "PostgreSQL",
  "query": "\n        select\n            x.pli_id,\n            x.ecriture_id,\n            p.gabarit as \"gabarit: Gabarit\",\n            p.contenu as original,\n            p.sceau_id as sceau_origine,\n            p.signe,\n            a.id as \"auteur_id?\",\n            a.nom as \"auteur_nom?\"\n        from exemplaires x\n        join plis p on p.id = x.pli_id\n        left join personnages a on a.id = p.auteur_id\n        where x.id = $1\n        for update of x\n        ",
