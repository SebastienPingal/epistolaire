  "query": "\n        select\n            id              as \"id!\",\n            gabarit         as \"gabarit!: Gabarit\",\n            arrive_le       as \"arrive_le!\",\n            ouvert_le is not null as \"ouvert!\",\n            dossier_id,\n            sceau_nom,\n            sceau_initiales,\n            sceau_image,\n            sceau_etat      as \"sceau_etat: EtatSceau\"\n        from plis_recus\n        where destinataire_id = $1\n        order by arrive_le desc\n        ",
