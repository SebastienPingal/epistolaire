  "query": "\n        select\n            p.id, p.nom, p.genre as \"genre: GenrePersonnage\", c.email::text as \"email?\",\n            p.ecriture_id, p.role, p.domaine, p.aptitudes, p.objectifs, p.notes_mj, p.quota_hebdo\n        from personnages p\n        left join comptes c on c.id = p.compte_id\n        where p.id = $1\n        ",
