  "query": "\n        select\n            k.personnage_id, p.nom, k.qualite, k.origine as \"origine: OrigineContact\"\n        from contacts k\n        join personnages p on p.id = k.personnage_id\n        where k.proprietaire_id = $1\n        order by lower(p.nom)\n        ",
