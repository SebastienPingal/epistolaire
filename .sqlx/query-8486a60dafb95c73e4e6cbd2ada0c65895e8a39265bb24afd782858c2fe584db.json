  "query": "\n        select\n            p.id, p.nom, p.genre as \"genre: GenrePersonnage\", p.role,\n            c.email::text as \"email?\", p.ecriture_id\n        from personnages p\n        left join comptes c on c.id = p.compte_id\n        order by p.genre, lower(p.nom)\n        ",
